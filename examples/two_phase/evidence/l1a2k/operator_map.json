{
  "decomposition_definition": {
    "curl_label": "diagnostic_curl_v1 (the solver defines no canonical production curl operator)",
    "equations": [
      "D_h G_h q = D_h a_sigma^h, with q obtained from the production poisson_solve and m2_proj",
      "a_sigma,grad^h = G_h q",
      "a_sigma,perp^h = a_sigma^h - G_h q"
    ],
    "label": "production_operator_decomposition",
    "not_claimed": "This report does not call the result an exact orthogonal Hodge decomposition. A separate uniform-grid periodic adjoint/inner-product check is reported; numerical precision and the momentum-grid metric are stated explicitly."
  },
  "mask_policy": {
    "contact_line": "contact_line_kinetics.contact_line_positions at level phi=0.5; periodic x distance and fixed wall plane, with radii 2dx and 4dx",
    "gas": "fluid cell centres with phi <= 0.05",
    "interface": "fluid cell centres with 0.05 <= phi <= 0.95",
    "liquid": "fluid cell centres with phi >= 0.95",
    "overlap": "regional masks intentionally overlap; regional L2 fractions are not additive",
    "wall_shells": "signed-distance bins fixed at integer multiples of dx; no post-hoc tuning",
    "y_seam": "two- and four-cell strips adjacent to the periodic y seam"
  },
  "production_momentum_and_pressure_operators": {
    "acceleration": "force_density / rho_l, with rho_l a spatially constant scalar in the production config",
    "brinkman": "unchanged local damping 1 / (1 + (dt/3) * solid.chi / p.eta_pen) before each pressure projection",
    "density_treatment": "rho_of(phi) is formed in rhs; with use_gravity=False, the current momentum RHS/projection has no variable-density inertia or variable-coefficient pressure weighting; nu_of(phi) remains the production viscosity model",
    "divergence": "D_h a = phasefield._ddx(a_x, dx) + phasefield._ddy(a_y, dy); same centred periodic differences",
    "force_density": "(SIGMA_NORM / We) * mu_h * G_h(phi)",
    "gradient": "G_h q = (phasefield._ddx(q, dx), phasefield._ddy(q, dy)); centred periodic differences on axes 0 and 1",
    "momentum_area_weight": "dx * dy uniformly on the full momentum grid; cut-cell phase volumes do not weight momentum or pressure projection",
    "momentum_grid": "uniform cell-centred Nx by Ny periodic grid; momentum/Brinkman/projection are evaluated on every grid cell",
    "phase_wall_energy": "the production chemical potential includes the selected wall-energy derivative once; its resulting contribution to mu_h * G_h(phi) is separately decomposed, without modifying wall energy or momentum",
    "pressure_operator": "D_h G_h with Fourier symbol -PhaseFieldParams.m2_proj; all exact discrete null modes are removed by phasefield.poisson_solve",
    "pressure_solve": "q = pf.poisson_solve(D_h a, p.m2_proj), solving the production constant-coefficient periodic operator; no continuum-k^2 surrogate",
    "production_projection_stage": "per internal substep: damped predictor, div/dt, poisson_solve(..., p.m2_proj), then subtract dt * G_h pressure",
    "production_velocity_dtype": "p.dtype (float32 in all matched cases); phase/chemical-potential intermediates are float64 under phase_only_float64_v1",
    "rhs_cast": "pf.rhs sums momentum addends and casts the full u_rhs/v_rhs back to p.dtype; the audit records the raw expression, its production-dtype cast, and the exact marginal addend after the production RHS cast"
  },
